make_index() {
  local tmp="$WEBROOT/.index.new"
  local entry slug name desc cg cid ver vtxt vcls uri ar k v apps rr gg bb on href
  local last=0 lastfmt='' lastiso='' tgt t
  local i=0 n total=0
  local -A V=() CNT=() LIVE=() HREF=()
  # Versionen unverändert aus der Versionsdatei lesen (slug=tag)
  while IFS='=' read -r k v || [[ -n ${k:-} ]]; do
    [[ -n ${k:-} ]] && V[$k]=$v
  done < "$VERS"
  # Lokale Apps (nicht von craft-update installiert): nur nachsehen, ob sie da sind. Version und Link kommen von dort.
  for entry in "${LOCAL_APPS[@]}"; do
    IFS='|' read -r slug name desc <<<"$entry"
    local_probe "$slug" || continue
    LIVE[$slug]=1; V[$slug]=$LOCAL_VER; HREF[$slug]=$LOCAL_HREF
  done
  # Vorlauf: installierte Apps zählen (Craft-Apps: Symlink vorhanden; lokale Apps: von local_probe gefunden)
  for entry in "${ALL_APPS[@]}"; do
    IFS='|' read -r slug name desc <<<"$entry"
    [[ -L "$WEBROOT/$slug" || -n ${LIVE[$slug]:-} ]] || continue
    cg=${CATEGORY[$slug]:-weitere}
    [[ -n ${CAT_TITLE[$cg]:-} ]] || cg=weitere
    CNT[$cg]=$(( ${CNT[$cg]:-0} + 1 ))
    total=$(( total + 1 ))
    # Zeitpunkt der Installation des aktuell ausgelieferten Releases (install_app setzt per touch den Zeitstempel).
    # Nur Craft-Apps: lokale Apps haben keinen Symlink im Webroot und zählen für "Zuletzt aktualisiert" nicht.
    [[ -L "$WEBROOT/$slug" ]] && tgt=$(readlink -f -- "$WEBROOT/$slug" 2>/dev/null) && t=$(stat -c %Y -- "$tgt" 2>/dev/null) && (( t > last )) && last=$t
  done
  if (( last > 0 )); then
    lastfmt=$(date -d "@$last" '+%d.%m.%Y, %H:%M' 2>/dev/null) || lastfmt=''
    lastiso=$(date -d "@$last" -Iseconds 2>/dev/null) || lastiso=''
  fi
  {
    cat <<'HTML'
