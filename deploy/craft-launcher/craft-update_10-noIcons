#!/usr/bin/env bash
# Lädt die Web-Builds der Craft Apps (github.com/storytold/<app>), prüft SHA-256
# und schaltet neue Versionen atomar per Symlink frei.
# Erzeugt danach die Startseite (Pi-Launcher) unter $WEBROOT/index.html neu.
# Lokale Apps (LOCAL_APPS, derzeit waread) installiert und aktualisiert dieses Skript NICHT. Sie haben eine
# eigene Installation in eigenen Verzeichnissen. Die Startseite verlinkt sie nur und liest dafür lediglich
# ihren Installationszustand und, für das Ziel des Links, den Schlüssel web.passkey_origin aus ihrer Konfiguration.
set -uo pipefail
WEBROOT=/var/www/craft
STATE=${STATE_DIRECTORY:-/var/lib/craft}
REL=$STATE/releases
WORK=$STATE/work
VERS=$STATE/versions
KEEP=2   # so viele Versionen pro App bleiben für ein Rollback liegen
APPS=(
  "photocraft|PhotoCraft|Bildbearbeitung"
  "vectorcraft|VectorCraft|Vektorgrafik"
  "filmcraft|FilmCraft|Videoschnitt"
  "lightcraft|LightCraft|RAW-Fotos"
  "pdfcraft|PdfCraft|PDF"
  "effectcraft|EffectCraft|Motion Graphics"
  "designcraft|DesignCraft|Seitenlayout"
  "wordcraft|WordCraft|Textverarbeitung"
  "deckcraft|DeckCraft|Präsentationen"
  "gridcraft|GridCraft|Tabellen"
  "cadcraft|CADCraft|CAD"
  "soundcraft|SoundCraft|Audio"
  "figcraft|FigCraft|UI-Design"
)
# Lokale Apps: NICHT von craft-update geladen, installiert oder aktualisiert, nur auf der Startseite verlinkt.
# Die Karte erscheint nur, wenn local_probe die App findet. Format wie APPS (slug|Name|Beschreibung).
# Neue lokale App: hier eintragen, in local_probe die Prüfung ergänzen, Icon (ICON_B64) und Akzentfarbe (ACCENT) setzen.
LOCAL_APPS=(
  "waread|waread|WhatsApp lesen"
)
ALL_APPS=("${APPS[@]}" "${LOCAL_APPS[@]}")   # nur für die Startseite; heruntergeladen wird ausschließlich aus APPS
# waread: eigene Installation (deploy/install.sh von waread) unter /opt/waread. Hier wird dort nur gelesen.
WAREAD_HOME=/opt/waread
WAREAD_CONF=/etc/waread/config.toml   # wird nur gelesen, und zwar nur der Schlüssel passkey_origin
# Ziel der waread-Karte. Leer = automatisch:
#   - Ist in WAREAD_CONF web.passkey_origin gesetzt (Passkey-Betrieb: eigener Hostname mit HTTPS, also eigener Origin),
#     zeigt die Karte auf <passkey_origin>/waread/.
#   - Sonst auf ./waread/ (Pfad auf diesem Host; Nginx-Snippet von waread, deploy/craft-launcher/README.md).
# Festlegen: die ganze URL eintragen, z. B. https://waread.heimnetz.example/waread/ oder ./waread/
WAREAD_URL=''
# Prüft eine lokale App, nur lesend. Rückgabe 0 = installiert.
# Setzt LOCAL_VER (Version mit "v", leer = unbekannt) und LOCAL_HREF (Ziel der Karte).
local_probe() {
  local cur tgt o
  LOCAL_VER=''
  LOCAL_HREF="./$1/"
  case $1 in
    waread)
      # install.sh und waread-update halten /opt/waread/current als Symlink auf releases/<X.Y.Z>.
      cur=$WAREAD_HOME/current
      [[ -L $cur && -f $cur/services/web/dist/server.js ]] || return 1
      LOCAL_HREF=${WAREAD_URL:-./waread/}
      if [[ -z $WAREAD_URL ]]; then
        # Nur die Zeile passkey_origin = "https://Name[:Port]" (nicht auskommentiert); alles andere wird ignoriert.
        o=$(sed -nE 's/^[[:space:]]*passkey_origin[[:space:]]*=[[:space:]]*"([^"]*)".*$/\1/p' "$WAREAD_CONF" 2>/dev/null | head -n 1)
        [[ $o =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]] && LOCAL_HREF=$o/waread/
      fi
      tgt=$(readlink -f -- "$cur" 2>/dev/null) || return 0
      tgt=${tgt##*/}
      [[ $tgt =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && LOCAL_VER="v$tgt"
      return 0 ;;
  esac
  return 1
}
CURL=(curl --fail --silent --show-error --location --proto '=https' --tlsv1.2
      --retry 3 --retry-delay 5 --connect-timeout 15 --max-time 900)
mkdir -p "$REL" "$WORK" "$WEBROOT"
exec 9>"$STATE/lock"
flock -n 9 || { echo "Update läuft bereits."; exit 0; }
touch "$VERS"
find "$WORK" -mindepth 1 -delete
latest_tag() {
  local url tag
  url=$(curl --fail --silent --show-error --location --head --proto '=https' \
        --retry 3 --connect-timeout 15 --output /dev/null \
        --write-out '%{url_effective}' \
        "https://github.com/storytold/$1/releases/latest") || return 1
  tag=${url##*/}
  [[ $tag =~ ^v[0-9][0-9A-Za-z._-]*$ ]] || return 1
  printf '%s' "$tag"
}
install_app() {
  local slug=$1 tag=$2 ver=${2#v}
  local asset="${slug}-web-${ver}.zip"
  local base="https://github.com/storytold/${slug}/releases/download/${tag}"
  local dir="$WORK/$slug" target="$REL/${slug}-${tag}" src sum
  mkdir -p "$dir/x" || return 1
  "${CURL[@]}" -o "$dir/$asset" "$base/$asset" \
    || { echo "  Download fehlgeschlagen: $asset"; return 1; }
  "${CURL[@]}" -o "$dir/SHA256SUMS.txt" "$base/SHA256SUMS.txt" \
    || { echo "  SHA256SUMS.txt nicht gefunden"; return 1; }
  sum=$(awk -v f="$asset" '{n=$2; sub(/^\*/,"",n)} n==f {print $1; exit}' "$dir/SHA256SUMS.txt")
  [[ -n $sum ]] || { echo "  Keine Prüfsumme für $asset"; return 1; }
  echo "$sum  $dir/$asset" | sha256sum -c --quiet - \
    || { echo "  Prüfsumme stimmt NICHT, Abbruch"; return 1; }
  unzip -q "$dir/$asset" -d "$dir/x" || { echo "  Entpacken fehlgeschlagen"; return 1; }
  src=$(find "$dir/x" -mindepth 1 -maxdepth 1 -type d -name "${slug}-web-*" -print -quit)
  [[ -n $src && -f $src/index.html ]] || { echo "  Unerwartete Zip-Struktur"; return 1; }
  rm -rf "$target"
  mv "$src" "$target" || return 1
  chmod -R a+rX,go-w "$target"
  touch "$target"
  # Atomar umschalten: Symlink neu setzen und über den alten rübermoven
  ln -sfn "$target" "$WEBROOT/.${slug}.new" \
    && mv -T "$WEBROOT/.${slug}.new" "$WEBROOT/$slug" || return 1
  { grep -v "^${slug}=" "$VERS" || true; echo "${slug}=${tag}"; } > "$VERS.new" \
    && mv "$VERS.new" "$VERS"
  # Alte Versionen aufräumen (die neueste bleibt immer)
  ls -1dt "$REL/${slug}"-v* 2>/dev/null | tail -n +$((KEEP + 1)) | xargs -r rm -rf --
  return 0
}

