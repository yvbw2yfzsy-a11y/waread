.icon-btn svg{width:21px;height:21px}
@media(max-width:640px){.brand{order:1}.icon-btn{order:2}.search{order:3;flex:1 1 100%}}

/* Einstieg */
.hero{display:flex;align-items:flex-end;justify-content:space-between;gap:22px 40px;flex-wrap:wrap;padding-block:clamp(26px,4.5vw,54px) clamp(6px,1.4vw,14px)}
.hero h1{margin:0;font-size:clamp(2.05rem,4.8vw,3.2rem);line-height:1.04;letter-spacing:-.04em;font-weight:790}
.hero h1 em{font-style:normal;background:linear-gradient(100deg,#6366f1,#ec4899 58%,#f59e0b);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{margin:12px 0 0;max-width:46ch;color:var(--mu);font-size:clamp(1rem,1.5vw,1.12rem)}

/* Kategorien */
main{position:relative;isolation:isolate;padding-bottom:clamp(28px,5vw,56px)}
/* Jede Kategorie: Banner + Hintergrundzone in denselben zwei Farben. Die Zone ist oben und unten per Maske
   ausgeblendet und überlappt die Nachbarzonen, dadurch gehen die Farben weich ineinander über. */
.cat{--c1:99 102 241;--c2:139 92 246;position:relative;margin-top:clamp(70px,8vw,110px)}
.zone{position:absolute;z-index:-1;left:0;right:0;top:-190px;bottom:-190px;pointer-events:none;overflow:hidden;
  -webkit-mask-image:linear-gradient(180deg,transparent 0,#000 190px,#000 calc(100% - 190px),transparent 100%);
  mask-image:linear-gradient(180deg,transparent 0,#000 190px,#000 calc(100% - 190px),transparent 100%)}
.zone::before{content:"";position:absolute;inset:0;
  background:radial-gradient(60% 52% at 10% 34%,rgb(var(--c1) / var(--za)),transparent 72%),
             radial-gradient(60% 52% at 92% 70%,rgb(var(--c2) / var(--za)),transparent 72%),
             linear-gradient(115deg,rgb(var(--c1) / calc(var(--za) * .6)),rgb(var(--c2) / calc(var(--za) * .6)))}
.zi{position:absolute;inset:190px 0}   /* = Bereich der Kategorie selbst; Szenen werden relativ dazu platziert */
.sc{position:absolute;display:block;height:auto;width:clamp(250px,26vw,420px);color:rgb(var(--c1) / var(--sca));filter:blur(var(--scb))}
.sc.s1{left:31%;top:158px}      /* direkt unter dem Banner beginnen, nach unten hin laufen sie in der Zonenmaske aus */
.sc.s2{right:1.5%;top:158px}
.sc.s3{left:1.5%;top:300px}
:root[data-theme=dark] .sc{color:rgb(255 255 255 / var(--sca))}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .sc{color:rgb(255 255 255 / var(--sca))}}
.banner{position:relative;overflow:hidden;display:flex;align-items:center;min-height:136px;padding:24px 30px;margin-bottom:16px;border-radius:28px;color:#fff;
  background:radial-gradient(90% 160% at 0% 0%,rgb(255 255 255 / .2),transparent 60%),linear-gradient(115deg,rgb(var(--c1)),rgb(var(--c2)));
  box-shadow:0 22px 44px -26px rgb(var(--c1) / .8),inset 0 1px 0 rgb(255 255 255 / .25)}
.banner::after{content:"";position:absolute;inset:0;background:rgb(0 0 0 / var(--dim));pointer-events:none}
.banner .art{position:absolute;top:0;right:0;width:min(62%,760px);height:100%;pointer-events:none;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 40%);mask-image:linear-gradient(90deg,transparent 0,#000 40%)}
.bn-t{position:relative;z-index:2;display:flex;align-items:center;gap:16px}
.bn-t .dot{display:grid;place-items:center;flex:none;width:48px;height:48px;border-radius:16px;background:rgb(255 255 255 / .2);box-shadow:inset 0 1px 0 rgb(255 255 255 / .3)}
.bn-t .dot svg{width:24px;height:24px}
.bn-t h2{margin:0;font-size:clamp(1.4rem,2.6vw,1.85rem);line-height:1.1;letter-spacing:-.025em;font-weight:780}
.bn-t small{display:block;margin-top:4px;font-size:.95rem;line-height:1.3;color:rgb(255 255 255 / .9)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:14px}

/* Karten */
.card{--ar:99 102 241;position:relative;display:grid;grid-template-columns:auto minmax(0,1fr) auto;grid-template-areas:"ic tx go" "ic ver go";align-items:center;column-gap:16px;row-gap:8px;
  min-height:112px;padding:18px;border-radius:24px;color:inherit;text-decoration:none;
  background:radial-gradient(120% 150% at 0% 0%,rgb(var(--ar) / var(--wash)),transparent 60%),var(--cardg);
  -webkit-backdrop-filter:blur(5px) saturate(1.25);backdrop-filter:blur(5px) saturate(1.25);
  border:1px solid var(--ln);box-shadow:var(--sh);
  transition:transform .25s cubic-bezier(.2,.7,.2,1),box-shadow .25s,border-color .25s;animation:rise .55s cubic-bezier(.2,.7,.2,1) backwards;animation-delay:calc(var(--i,0) * 35ms)}
.card:active{transform:scale(.985)}
.card:focus-visible{outline:3px solid rgb(var(--ar) / .7);outline-offset:3px}
@media(hover:hover){
  .card:hover{transform:translateY(-4px);border-color:rgb(var(--ar) / .45);box-shadow:0 1px 2px rgb(21 24 35 / .06),0 22px 40px -22px rgb(var(--ar) / .45)}
  .card:hover .ic{transform:scale(1.05)}
  .card:hover .go{transform:translateX(3px) scale(1.06);box-shadow:0 10px 20px -8px rgb(var(--ar) / .9),inset 0 1px 0 rgb(255 255 255 / .3)}
}
.ic{grid-area:ic;position:relative;width:68px;height:68px;border-radius:19px;transition:transform .3s cubic-bezier(.2,.7,.2,1)}
.ic img,.ic .gl{display:block;width:100%;height:100%;border-radius:inherit}
.ic img{object-fit:cover;box-shadow:0 9px 16px -11px rgb(var(--ar) / .55)}
.ic .gl{display:grid;place-items:center;color:#fff;background:linear-gradient(150deg,rgb(var(--ar)),rgb(var(--ar) / .72));box-shadow:0 9px 16px -11px rgb(var(--ar) / .55),inset 0 1px 0 rgb(255 255 255 / .3)}
.tx{grid-area:tx;align-self:end;min-width:0}
.tx b{display:block;font-size:1.12rem;line-height:1.25;font-weight:720;letter-spacing:-.015em}
.ds{display:block;color:var(--mu);font-size:.93rem;line-height:1.35;overflow-wrap:anywhere}
.ver{grid-area:ver;align-self:start;justify-self:start;max-width:100%;font-size:.75rem;font-weight:650;line-height:1.5;padding:1px 10px;border-radius:99px;font-variant-numeric:tabular-nums;
  background:rgb(var(--ar) / .14);border:1px solid rgb(var(--ar) / .3);overflow-wrap:anywhere}
.ver.unk{background:var(--field);border-color:var(--ln);color:var(--mu)}
.go{grid-area:go;display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:rgb(var(--ar));color:var(--on,#fff);box-shadow:0 8px 16px -8px rgb(var(--ar) / .75),inset 0 1px 0 rgb(255 255 255 / .3);transition:transform .25s,box-shadow .25s}
.go svg{width:18px;height:18px}
@media(max-width:640px){
  .cat{margin-top:64px}
  .zone{top:-150px;bottom:-150px;-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 150px,#000 calc(100% - 150px),transparent 100%);mask-image:linear-gradient(180deg,transparent 0,#000 150px,#000 calc(100% - 150px),transparent 100%)}
  .zi{inset:150px 0}
  .sc{width:270px}
  .sc.s1{left:-60px;top:140px}
  .sc.s2{right:-70px;top:400px}
  .sc.s3{left:14%;top:650px}
  .banner{min-height:108px;padding:18px 20px;margin-bottom:12px;border-radius:24px}
  .banner .art{width:52%;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 55%);mask-image:linear-gradient(90deg,transparent 0,#000 55%)}
  .bn-t{max-width:60%}
  .bn-t .dot,.bn-t .n{display:none}
  .grid{gap:12px}
  .card{min-height:92px;padding:14px 16px;column-gap:14px;row-gap:6px;border-radius:22px}
  .ic{width:60px;height:60px;border-radius:17px}
}
@keyframes rise{from{opacity:0;transform:translateY(12px)}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}

.empty{margin:48px 0;padding:34px 20px;text-align:center;color:var(--mu);border:1px dashed var(--ln);border-radius:22px}
.empty code{font:.9em ui-monospace,SFMono-Regular,Menlo,monospace;background:var(--field);padding:2px 7px;border-radius:7px}
.foot{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 20px;padding-block:20px calc(26px + env(safe-area-inset-bottom));border-top:1px solid var(--ln);color:var(--mu);font-size:.85rem}
</style>
