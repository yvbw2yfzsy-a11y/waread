    continue
  fi
  found=$((found + 1))
  if grep -qxF "${slug}=${tag}" "$VERS" && [[ -L "$WEBROOT/$slug" ]]; then
    echo "$name: aktuell ($tag)"
    continue
  fi
  echo "$name: installiere $tag ..."
  if install_app "$slug" "$tag"; then echo "$name: OK ($tag)"; else echo "$name: FEHLER"; fail=1; fi
  find "$WORK" -mindepth 1 -delete
done
# waread (lokale App): nur melden, ob sie erkannt wurde und ob Nginx /waread/ weiterleitet. Ändert nichts.
if local_probe waread; then
  echo "waread: installiert ${LOCAL_VER:-(Version unbekannt)}, Karte verlinkt auf $LOCAL_HREF"
