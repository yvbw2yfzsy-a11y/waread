        ar=${ACCENT[$slug]:-$DEFAULT_ACCENT}
        read -r rr gg bb <<<"$ar"
        if (( (rr * 299 + gg * 587 + bb * 114) / 1000 >= 140 )); then on='#10131a'; else on='#fff'; fi   # helle Akzentfarbe: dunkler Pfeil
        href=${HREF[$slug]:-./$slug/}   # Craft-Apps: ./<slug>/ ; lokale Apps: Ziel aus local_probe
        printf '<a class="card" href="%s" data-k="%s" style="--ar:%s;--on:%s;--i:%d">\n' \
