# waread-cleanup-vacuum.timer
#
# Startet waread-cleanup-vacuum.service einmal pro Woche, sonntags gegen 04:30
# (Europe/Berlin), plus bis zu 10 Minuten Streuung. Dank der gemeinsamen Sperrdatei
# warten sich Aufräumlauf (:17) und VACUUM gegenseitig ab, falls sie sich überschneiden.
# Persistent=true holt einen verpassten Lauf nach, wenn der Pi aus war.

[Unit]
Description=waread Datenbank-VACUUM wöchentlich

[Timer]
OnCalendar=Sun *-*-* 04:30:00 Europe/Berlin
RandomizedDelaySec=600
AccuracySec=1min
Persistent=true
Unit=waread-cleanup-vacuum.service

[Install]
WantedBy=timers.target
